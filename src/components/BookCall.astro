---
// "Book a 30-minute call" (V2): espresso section with contact details on the
// left and the inline Calendly scheduler on the right. Used at the bottom of
// most pages; the homepage marks it data-home="book".
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";
import { countiesSentence } from "../lib/utils/areas";
import CalendlyEmbed from "./CalendlyEmbed.astro";

export interface Props {
  heading?: string;
  intro?: string;
  home?: boolean;
}
const {
  heading = "Book a 30-minute call.",
  intro = "Have questions or thinking about buying or selling? Pick a time that suits you, and we'll talk through your goals and what's next.",
  home = false,
} = Astro.props;
const site = await getSiteInfo();
const counties = countiesSentence(site.serviceAreaOfCoverage);
---

<section class="book" id="book" data-home={home ? "book" : undefined}>
  <div class="container book__grid">
    <div data-reveal>
      <h2 class="book__heading">{heading}</h2>
      <p class="lede">{intro}</p>
      <ul class="book__list">
        {site.phoneNumber && <li><i class="icon-call" aria-hidden="true"></i><a class="book__phone" href={phoneHref(site)}>{site.phoneNumber}</a></li>}
        {site.email && <li><i class="icon-mail" aria-hidden="true"></i><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        <li><i class="icon-hours" aria-hidden="true"></i><span>Mon to Sun, 8am to 8pm. Evenings by appointment.</span></li>
      </ul>
      {counties && <p class="book__counties">Serving {counties}.</p>}
    </div>
    <div data-reveal><CalendlyEmbed /></div>
  </div>
</section>

<style>
  .book { background: var(--main-dark); color: var(--on-dark-muted); padding-block: clamp(5rem, 10vw, 9rem); }
  .book__grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .book__heading { color: var(--white); }
  .book__list { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: var(--space-lg); }
  .book__list li { display: flex; gap: var(--space-md); align-items: center; }
  .book__list i { font-size: 1.3rem; color: var(--cta); }
  .book__list a { color: var(--white); text-decoration: none; }
  .book__phone { white-space: nowrap; }
  .book__counties { margin: 2.5rem 0 0; padding-block-start: var(--space-xl); border-block-start: 1px solid var(--hairline-on-dark); font-size: var(--font-size-sm); }
  @media (max-width: 900px) { .book__grid { grid-template-columns: 1fr; } }
</style>
