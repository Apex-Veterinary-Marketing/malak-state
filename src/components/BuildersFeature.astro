---
// Full-bleed photo with a white panel (V2 builders section). Links to the
// Builders & Developers page.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  heading: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  cta: { text: string; href: string };
}
const { heading, text, image, imageAlt, cta } = Astro.props;
---

<section class="builders" data-home="builders">
  <Image src={image} alt={imageAlt} class="builders__image" widths={[800, 1400, 2000]} sizes="100vw" />
  <div class="builders__panel" data-reveal>
    <h2>{heading}</h2>
    <p class="lede">{text}</p>
    <a class="btn btn--cta builders__cta" href={cta.href}>{cta.text}</a>
  </div>
</section>

<style>
  .builders { position: relative; min-height: 88vh; display: flex; align-items: flex-end; }
  .builders__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .builders__panel { position: relative; max-width: 560px; margin: 0 clamp(var(--space-md), 5vw, 5rem) clamp(var(--space-md), 5vw, 5rem) auto; padding: clamp(2rem, 4vw, 3.5rem); background: var(--white); }
  .builders__cta { margin-block-start: var(--space-xl); }
  @media (max-width: 767px) {
    .builders { display: block; min-height: 0; }
    .builders__image { position: static; height: 50vh; }
    .builders__panel { margin: calc(var(--space-xl) * -1) var(--space-md) 0; }
  }
</style>
