---
// Full-width call-to-action band. Generic/token-driven; not grounded in a
// staged real-markup reference. See Skeleton-Build-Spec.md §6.
// The button defaults to the site's booking action (site.bookingUrl /
// bookingLabel) — pass ctaText/ctaHref only when a page needs another target.
import { getSiteInfo } from "../lib/data/site";

export interface Props {
  heading: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
}
const site = await getSiteInfo();
const { heading, text, ctaText = site.bookingLabel || "Book Now", ctaHref = site.bookingUrl || "/contact-us" } = Astro.props;
---

<section class="cta-band">
  <div class="cta-band__inner">
    <div class="cta-band__copy">
      <h2 class="cta-band__heading">{heading}</h2>
      {text && <p class="cta-band__text">{text}</p>}
    </div>
    <a class="btn btn--cta" href={ctaHref}>{ctaText}</a>
  </div>
</section>

<style>
  .cta-band { background: var(--main-dark); color: var(--on-dark-muted); }
  .cta-band__inner { max-width: var(--container-max); margin-inline: auto; padding: clamp(4rem, 8vw, 6rem) clamp(var(--space-md), 4vw, var(--space-xl)); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-lg); }
  .cta-band__heading { margin: 0 0 var(--space-xs); color: var(--white); }
  .cta-band__text { margin: 0; max-width: 52ch; }
</style>
