---
// Used by service-detail FAQs (services.faqs) and the site FAQ page.
// Native <details>/<summary> — zero JS, same accessible pattern as Footer.
// See Skeleton-Build-Spec.md §6 and §10 ("LLM data" — Q&A-shaped content).
export interface Props {
  faqs: { question: string; answer: string }[];
  heading?: string;
}
const { faqs, heading } = Astro.props;
---

{faqs.length > 0 && (
  <div class="faq-accordion">
    {heading && <h2 class="faq-accordion__heading">{heading}</h2>}
    {faqs.map((faq) => (
      <details class="faq-accordion__item">
        <summary class="faq-accordion__question">{faq.question}</summary>
        <div class="faq-accordion__answer" set:html={faq.answer} />
      </details>
    ))}
  </div>
)}

<style>
  .faq-accordion { display: flex; flex-direction: column; }
  .faq-accordion__heading { margin: 0 0 var(--space-lg); }
  .faq-accordion__item { border-block-start: 1px solid var(--light-grey); }
  .faq-accordion__item:last-child { border-block-end: 1px solid var(--light-grey); }
  .faq-accordion__question { position: relative; list-style: none; cursor: pointer; padding: var(--space-lg) var(--space-2xl) var(--space-lg) 0; font: 400 var(--font-size-lg) / 1.35 var(--font-heading); color: var(--main-dark); }
  .faq-accordion__question::-webkit-details-marker { display: none; }
  .faq-accordion__question::before, .faq-accordion__question::after { content: ""; position: absolute; inset-inline-end: var(--space-xs); inset-block-start: 50%; width: 14px; height: 1.5px; background: var(--main); transition: transform var(--motion-duration-slow) var(--motion-ease); }
  .faq-accordion__question::after { transform: rotate(90deg); }
  .faq-accordion__item[open] .faq-accordion__question::after { transform: rotate(0deg); }
  .faq-accordion__answer { padding: 0 var(--space-2xl) var(--space-lg) 0; max-width: 68ch; }
  .faq-accordion__answer :global(a) { color: var(--main); }
</style>
