---
// V2 footer: espresso, wordmark + "Brokered by Real of Ohio" (Ohio license law
// wants the brokerage name in advertising — keep it on every page), Explore /
// Services / Contact columns, legal row. ReviewsBand stays mounted here (it's a
// fixed floating pill and only renders once a real Google rating is set).
import { getSiteInfo } from "../lib/data/site";
import { getAllServices } from "../lib/data/services";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import { SOCIAL_LABELS } from "../lib/icons/social";
import { phoneHref } from "../lib/utils/phone";
import ReviewsBand from "./ReviewsBand.astro";
import { countiesSentence } from "../lib/utils/areas";

const site = await getSiteInfo();
const services = await getAllServices();
const socialLinks = await getAllSocialLinks();
const year = new Date().getFullYear();
const countiesText = countiesSentence(site.serviceAreaOfCoverage);
---

<footer class="footer">
  <ReviewsBand />
  <div class="footer__grid">
    <div class="footer__brand">
      <a class="footer__wordmark" href="/">{site.practiceName}</a>
      {site.brokerageName && <p class="footer__brokerage">Brokered by {site.brokerageName}</p>}
      {site.footerAbout && <p class="footer__about">{site.footerAbout}</p>}
      {socialLinks.length > 0 && (
        <p class="footer__social">
          {socialLinks.map((s) => (
            <a href={s.data.link} target="_blank" rel="noopener noreferrer">{SOCIAL_LABELS[s.data.icon]}</a>
          ))}
        </p>
      )}
    </div>

    <nav class="footer__col" aria-label="Explore">
      <h2 class="footer__title">Explore</h2>
      <ul>
        <li><a href="/meet-the-team">Meet Marissa</a></li>
        <li><a href="/builders-developers">Builders &amp; Developers</a></li>
        <li><a href="/listings">Listings</a></li>
        <li><a href="/gather-and-ground">Gather &amp; Ground</a></li>
        <li><a href="/photo-gallery">Photo Gallery</a></li>
        <li><button type="button" class="footer__link-button" data-modal-target="reputation-widget">How'd We Do?</button></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Services">
      <h2 class="footer__title">Services</h2>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.id}`}>{s.data.customName || s.data.name}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">Contact</h2>
      <ul>
        {site.phoneNumber && <li><a class="footer__phone" href={phoneHref(site)}>{site.phoneNumber}</a></li>}
        {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        <li><a href={site.bookingUrl}>{site.bookingLabel}</a></li>
      </ul>
      {site.hours && <div class="footer__hours" set:html={site.hours} />}
      {countiesText && <p class="footer__areas">Serving {countiesText}.</p>}
    </div>
  </div>

  <div class="footer__legal">
    <span>&copy; {year} {site.practiceName}.{site.brokerageName && ` Brokered by ${site.brokerageName}.`}{site.brokerageLicense && ` License #${site.brokerageLicense}.`}</span>
    <span class="footer__legal-links"><a href="/privacy-policy">Privacy Policy</a><a href="/terms-of-use">Terms of Use</a></span>
  </div>
</footer>

<style>
  .footer { background: var(--footer-bg); color: var(--footer-text); padding-block: clamp(4rem, 8vw, 6rem) var(--space-xl); font-size: var(--font-size-sm); }
  .footer a, .footer__link-button { color: inherit; text-decoration: none; }
  .footer a:hover, .footer__link-button:hover { color: var(--white); }
  .footer__grid, .footer__legal { max-width: var(--container-max); margin-inline: auto; padding-inline: clamp(var(--space-md), 4vw, var(--space-xl)); }
  .footer__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: var(--space-xl); }
  .footer .footer__wordmark { font: 400 var(--font-size-2xl)/1.1 var(--font-heading); color: var(--white); }
  .footer__brokerage { margin: var(--space-xs) 0 0; font-size: var(--font-size-xs); letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--cta); }
  .footer__about { margin: var(--space-md) 0 0; max-width: 36ch; }
  .footer__social { display: flex; gap: var(--space-md); margin: var(--space-md) 0 0; }
  .footer__title { margin: 0 0 var(--space-md); font: 600 var(--font-size-xs)/1 var(--font-body); letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--footer-heading); }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xs); }
  .footer__link-button { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }
  .footer__phone { white-space: nowrap; }
  .footer__hours { margin-block-start: var(--space-md); }
  .footer__hours :global(p) { margin: 0; }
  .footer__areas { margin: var(--space-md) 0 0; }
  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-md); margin-block-start: var(--space-2xl); padding-block-start: var(--space-lg); border-block-start: 1px solid var(--hairline-on-dark); font-size: var(--font-size-xs); }
  .footer__legal-links { display: flex; gap: var(--space-lg); }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
