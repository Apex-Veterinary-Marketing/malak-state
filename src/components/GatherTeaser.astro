---
// Homepage Gather & Ground teaser (V2): text + next-event box beside a
// three-photo grid. Uses the gather-and-ground gallery album when it has
// photos, otherwise community placeholders.
import { Image } from "astro:assets";
import { getEventsSplit } from "../lib/data/events";
import { getGallery } from "../lib/data/gallery";
import ArrowLink from "./ArrowLink.astro";
import tablePh from "../assets/placeholders/community-table.jpg";
import flowersPh from "../assets/placeholders/community-flowers.jpg";
import friendsPh from "../assets/placeholders/community-friends.jpg";

const { upcoming } = await getEventsSplit();
const next = upcoming[0];
const album = await getGallery("gather-and-ground");
const photos =
  album.length >= 3
    ? album.slice(0, 3).map((g) => ({ src: g.data.image, alt: g.data.alt }))
    : [
        { src: tablePh, alt: "Long table set for a community dinner" },
        { src: flowersPh, alt: "Flowers and glassware on a shared table" },
        { src: friendsPh, alt: "Friends sitting together outdoors" },
      ];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "America/New_York" });
---

<section class="gg">
  <div class="container gg__grid">
    <div class="gg__text" data-reveal>
      <h2>Gather &amp; Ground.</h2>
      <p class="lede">A monthly community gathering Marissa co-sponsors, bringing neighbors around one table to connect and give back.</p>
      <div class="gg__event">
        <p class="eyebrow">Next gathering</p>
        <p class="gg__event-name">{next ? `${next.data.name}, ${fmt(next.data.startDate)}` : "Announced monthly"}</p>
      </div>
      <ArrowLink href="/gather-and-ground" text="Events and past photos" />
    </div>
    <Image src={photos[0].src} alt={photos[0].alt} class="gg__tall" data-reveal widths={[480, 900]} sizes="(max-width: 767px) 100vw, 33vw" />
    <Image src={photos[1].src} alt={photos[1].alt} class="gg__a" data-reveal widths={[480, 800]} sizes="(max-width: 767px) 100vw, 33vw" />
    <Image src={photos[2].src} alt={photos[2].alt} class="gg__b" data-reveal widths={[480, 800]} sizes="(max-width: 767px) 100vw, 33vw" />
  </div>
</section>

<style>
  .gg { background: var(--solid-bg); padding-block: clamp(5rem, 10vw, 9rem); }
  .gg__grid { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: auto auto; gap: var(--space-md); }
  .gg__text { grid-column: 1; grid-row: 1 / span 2; align-self: center; padding-inline-end: var(--space-xl); }
  .gg__grid img { width: 100%; height: 100%; object-fit: cover; }
  .gg__tall { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 3 / 4; }
  .gg__a, .gg__b { grid-column: 3; aspect-ratio: 4 / 3; }
  .gg__event { margin: var(--space-xl) 0 var(--space-lg); padding: var(--space-lg); background: var(--white); }
  .gg__event .eyebrow { margin-block-end: var(--space-2xs); }
  .gg__event-name { margin: 0; font: 400 1.3rem/1.3 var(--font-heading); color: var(--main-dark); }
  @media (max-width: 900px) {
    .gg__grid { grid-template-columns: 1fr 1fr; }
    .gg__text { grid-column: 1 / -1; grid-row: auto; padding: 0 0 var(--space-md); }
    .gg__tall { grid-column: 1; grid-row: auto; }
    .gg__a, .gg__b { grid-column: 2; }
  }
  @media (max-width: 767px) {
    .gg__grid { grid-template-columns: 1fr; }
    .gg__tall, .gg__a, .gg__b { grid-column: auto; aspect-ratio: 4 / 3; }
  }
</style>
