---
// V2 header (approved preview: docs/design/homepage-variations/v2-fullscreen-menu.html).
// A fixed 76px bar — wordmark, "Book a call", MENU — that opens a full-screen
// espresso overlay with large serif links. The bar has a solid background from
// the start and every page starts below it, so its links never sit on a photo.
//
// DOM contract (CSS, scripts and the a11y check rely on these):
//   [data-header]         gets .is-scrolled via an IntersectionObserver sentinel
//   [data-menu-toggle]    aria-expanded, aria-controls="site-menu"
//   #site-menu            role=dialog (no aria-modal: its Close toggle lives in the header);
//                         body.menu-open while open, and the page behind it is inert
// The About slot (Photo Gallery, How'd We Do?) is kept in the secondary list —
// How'd We Do? is the only way to open the reputation widget.
import { Image } from "astro:assets";
import { getSiteInfo } from "../lib/data/site";
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getServicesByCategory } from "../lib/data/services";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import { SOCIAL_LABELS } from "../lib/icons/social";
import { phoneHref } from "../lib/utils/phone";
import menuImage from "../assets/brand/marissa-living-room.jpg";

const site = await getSiteInfo();
const categories = await getAllServiceCategories();
const services = (await Promise.all(categories.map((c) => getServicesByCategory(c.id)))).flat();
const socialLinks = await getAllSocialLinks();

const links = [
  { href: "/", label: "Home" },
  { href: "/meet-the-team", label: "Meet Marissa" },
  { href: "/services", label: "Services", services: true },
  { href: "/builders-developers", label: "Builders & Developers" },
  { href: "/listings", label: "Listings" },
  { href: "/gather-and-ground", label: "Gather & Ground" },
  { href: "/contact-us", label: "Contact" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? current === "/" : current === href || current.startsWith(href + "/"));
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="header" data-header>
  <div class="header__bar">
    <a class="header__brand" href="/" aria-label={`${site.practiceName}, home`}>
      {site.logoColor ? (
        <img class="header__logo" src={site.logoColor} alt={site.practiceName} />
      ) : (
        <span class="header__wordmark">The <em>Malak</em> Estate Group</span>
      )}
    </a>
    <div class="header__actions">
      {site.bookingUrl && <a class="header__book" href={site.bookingUrl}>{site.bookingLabel}</a>}
      <button class="header__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
        <span class="header__toggle-label" data-menu-label>Menu</span>
        <span class="header__toggle-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-label="Site menu" data-menu hidden>
  <nav class="menu__nav" aria-label="Primary">
    <ul class="menu__links">
      {links.map((link, i) =>
        link.services ? (
          <li style={`--stagger-index:${i}`}>
            <details class="menu__services">
              <summary class="menu__link">{link.label}</summary>
              <ul class="menu__sub">
                {services.map((s) => (
                  <li><a href={`/services/${s.id}`}>{s.data.name}</a></li>
                ))}
                <li><a href="/services">All services</a></li>
              </ul>
            </details>
          </li>
        ) : (
          <li style={`--stagger-index:${i}`}>
            <a class="menu__link" href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
          </li>
        )
      )}
    </ul>
    <ul class="menu__secondary">
      <li><a href="/photo-gallery">Photo Gallery</a></li>
      <li><button type="button" data-modal-target="reputation-widget" data-menu-close>How'd We Do?</button></li>
      <li><a href="/faq">FAQ</a></li>
    </ul>
    <div class="menu__meta">
      {site.phoneNumber && (
        <div><p class="menu__meta-label">Call</p><a class="menu__phone" href={phoneHref(site)}>{site.phoneNumber}</a></div>
      )}
      {site.email && (
        <div><p class="menu__meta-label">Email</p><a href={`mailto:${site.email}`}>{site.email}</a></div>
      )}
      {socialLinks.length > 0 && (
        <div>
          <p class="menu__meta-label">Follow</p>
          {socialLinks.map((s) => (
            <a class="menu__social" href={s.data.link} target="_blank" rel="noopener noreferrer">{SOCIAL_LABELS[s.data.icon]}</a>
          ))}
        </div>
      )}
    </div>
  </nav>
  <div class="menu__media" aria-hidden="true">
    <Image src={menuImage} alt="" class="menu__image" widths={[640, 960]} sizes="45vw" loading="lazy" />
  </div>
</div>

<style>
  .header-sentinel { position: absolute; inset-block-start: 40px; inline-size: 1px; block-size: 1px; }
  .header { position: fixed; inset: 0 0 auto; z-index: 60; block-size: var(--header-height); display: flex; align-items: center; background: var(--solid-bg); transition: background-color var(--motion-duration-slow) var(--motion-ease), box-shadow var(--motion-duration-slow) var(--motion-ease); }
  .header.is-scrolled { background: var(--white-o85); box-shadow: 0 1px 0 var(--light-grey); backdrop-filter: blur(12px); }
  :global(body.menu-open) .header { background: var(--main-dark); box-shadow: none; backdrop-filter: none; }
  .header__bar { inline-size: 100%; max-inline-size: var(--container-max); margin-inline: auto; padding-inline: clamp(var(--space-md), 4vw, var(--space-xl)); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .header__brand { text-decoration: none; }
  .header__wordmark { font: 400 1.3rem/1 var(--font-heading); color: var(--main-dark); white-space: nowrap; }
  .header__wordmark em { font-style: italic; }
  .header__logo { block-size: var(--logo-height); inline-size: auto; }
  .header__actions { display: flex; align-items: center; gap: var(--space-lg); }
  .header__book { font-weight: 600; font-size: var(--font-size-sm); text-decoration: none; color: var(--main-dark); border-block-end: 1px solid var(--cta); padding-block-end: 2px; white-space: nowrap; }
  .header__toggle { display: inline-flex; align-items: center; gap: var(--space-sm); border: 0; background: none; padding: var(--space-sm) 0; cursor: pointer; font: 600 var(--font-size-xs)/1 var(--font-body); letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--main-dark); }
  .header__toggle-lines { position: relative; inline-size: 28px; block-size: 10px; }
  .header__toggle-lines::before, .header__toggle-lines::after { content: ""; position: absolute; inset-inline: 0; block-size: 1.5px; background: currentColor; transition: transform var(--motion-duration-slow) var(--motion-ease), inset-block-start var(--motion-duration-slow) var(--motion-ease); }
  .header__toggle-lines::before { inset-block-start: 0; }
  .header__toggle-lines::after { inset-block-start: 8px; }
  :global(body.menu-open) .header__wordmark,
  :global(body.menu-open) .header__book,
  :global(body.menu-open) .header__toggle { color: var(--white); }
  :global(body.menu-open) .header__toggle-lines::before { inset-block-start: 4px; transform: rotate(45deg); }
  :global(body.menu-open) .header__toggle-lines::after { inset-block-start: 4px; transform: rotate(-45deg); }
  @media (max-width: 420px) {
    .header__wordmark { font-size: 1.1rem; }
    .header__actions { gap: var(--space-md); }
    /* visually hidden, still announced */
    .header__toggle-label { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }

  /* Full-screen menu */
  .menu { position: fixed; inset: 0; z-index: 55; display: grid; grid-template-columns: 1.3fr 1fr; background: var(--main-dark); color: var(--on-dark-muted); clip-path: inset(0 0 100% 0); transition: clip-path var(--motion-duration-menu) var(--motion-ease-out); }
  .menu[hidden] { display: none; }
  .menu.is-open { clip-path: inset(0 0 0 0); }
  .menu__nav { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-xl); overflow-y: auto; padding: calc(var(--header-height) + var(--space-xl)) clamp(var(--space-lg), 6vw, 6rem) var(--space-xl); }
  .menu__links, .menu__sub, .menu__secondary { list-style: none; margin: 0; padding: 0; }
  .menu__links { display: grid; gap: 0.2rem; }
  .menu__links > li { opacity: 0; transform: translateY(var(--motion-distance)); transition: opacity var(--motion-duration-reveal) var(--motion-ease-out), transform var(--motion-duration-reveal) var(--motion-ease-out); }
  .menu.is-open .menu__links > li { opacity: 1; transform: none; transition-delay: calc(var(--motion-duration-base) + var(--stagger-index) * var(--motion-stagger)); }
  .menu__link { display: inline-block; cursor: pointer; font: 400 clamp(2rem, 4.4vw, 3.6rem)/1.15 var(--font-heading); color: var(--white); text-decoration: none; list-style: none; transition: color var(--motion-duration-slow) var(--motion-ease); }
  .menu__link::-webkit-details-marker { display: none; }
  .menu__link:hover, .menu__link[aria-current="page"] { color: var(--cta); font-style: italic; }
  .menu__services[open] .menu__link { color: var(--cta); }
  .menu__sub { display: grid; gap: var(--space-xs); padding: var(--space-sm) 0 var(--space-md) var(--space-2xs); }
  .menu__sub a { color: var(--on-dark-muted); text-decoration: none; font-size: var(--font-size-md); }
  .menu__sub a:hover { color: var(--white); }
  .menu__secondary { display: flex; flex-wrap: wrap; gap: var(--space-lg); }
  .menu__secondary a, .menu__secondary button { background: none; border: 0; padding: 0; font: 500 var(--font-size-md)/1.4 var(--font-body); color: var(--on-dark-muted); text-decoration: none; cursor: pointer; }
  .menu__secondary a:hover, .menu__secondary button:hover { color: var(--white); }
  .menu__meta { display: flex; flex-wrap: wrap; gap: var(--space-lg) var(--space-2xl); font-size: var(--font-size-sm); }
  .menu__meta-label { margin: 0 0 var(--space-xs); font-size: var(--font-size-xs); font-weight: 600; letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--cta); }
  .menu__meta a { color: var(--white); text-decoration: none; }
  .menu__phone { white-space: nowrap; }
  .menu__social + .menu__social { margin-inline-start: var(--space-md); }
  .menu__media { position: relative; overflow: hidden; margin-block-start: var(--header-height); }
  .menu__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; transform: scale(1.08); transition: transform var(--motion-duration-image) var(--motion-ease-out); }
  .menu.is-open .menu__image { transform: scale(1); }
  @media (max-width: 900px) { .menu { grid-template-columns: 1fr; } .menu__media { display: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const sentinel = document.querySelector("[data-header-sentinel]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  if (header && sentinel) {
    new IntersectionObserver(([entry]) => header.classList.toggle("is-scrolled", !entry.isIntersecting)).observe(sentinel);
  }

  if (toggle && menu && header) {
    const focusables = () =>
      [...header.querySelectorAll<HTMLElement>("a, button"), ...menu.querySelectorAll<HTMLElement>("a, button, summary")].filter(
        (el) => el.offsetParent !== null
      );
    const isOpen = () => document.body.classList.contains("menu-open");

    // Everything behind the overlay except the header (which holds the Close toggle).
    const background = () => document.querySelectorAll<HTMLElement>("main, footer.footer, .callbar, .skip-link");

    const setOpen = (open: boolean, returnFocus = true) => {
      background().forEach((el) => (el.inert = open));
      toggle.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Close" : "Menu";
      document.body.classList.toggle("menu-open", open);
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => {
          menu.classList.add("is-open");
          menu.querySelector<HTMLElement>(".menu__link")?.focus({ preventScroll: true });
        });
      } else {
        menu.classList.remove("is-open");
        const hide = () => { if (!isOpen()) menu.hidden = true; };
        menu.addEventListener("transitionend", hide, { once: true });
        setTimeout(hide, 1000); // no transition under reduced motion
        if (returnFocus) toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false, false)));
    menu.querySelectorAll("[data-menu-close]").forEach((b) => b.addEventListener("click", () => setOpen(false, false)));

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") { e.preventDefault(); setOpen(false); return; }
      if (e.key !== "Tab") return;
      const items = focusables();
      if (!items.length) return;
      const i = items.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : (i === items.length - 1 || i < 0 ? 0 : i + 1);
      e.preventDefault();
      items[next].focus();
    });
  }
</script>
