---
// Homepage split hero (V2 preview): text over --solid-bg on the left, a tall
// photo on the right. Starts below the fixed header. Never data-reveal'd —
// it's above the fold and must be visible immediately.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { renderEmphasis } from "../lib/utils/emphasis";

export interface Props {
  heading: string; // supports *italic* word
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  primary: { text: string; href: string };
  secondary?: { text: string; href: string };
}
const { heading, intro, image, imageAlt, imagePosition = "50% 45%", primary, secondary } = Astro.props;
---

<section class="home-hero" data-home="hero">
  <div class="home-hero__text">
    <h1 class="home-hero__heading" set:html={renderEmphasis(heading)} />
    <p class="home-hero__intro">{intro}</p>
    <div class="home-hero__ctas">
      <a class="btn btn--cta" href={primary.href}>{primary.text}</a>
      {secondary && <a class="btn btn--line" href={secondary.href}>{secondary.text}</a>}
    </div>
  </div>
  <div class="home-hero__media">
    <Image src={image} alt={imageAlt} class="home-hero__image" style={`object-position:${imagePosition}`} loading="eager" fetchpriority="high" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 50vw" />
  </div>
</section>

<style>
  .home-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 100dvh; padding-block-start: var(--header-height); background: var(--solid-bg); }
  .home-hero__text { display: flex; flex-direction: column; justify-content: center; padding: var(--space-xl) clamp(var(--space-lg), 5vw, 5rem) var(--space-2xl) max(clamp(var(--space-md), 4vw, var(--space-xl)), calc((100vw - var(--container-max)) / 2 + var(--space-xl))); }
  .home-hero__heading { font-size: clamp(2.6rem, 4.4vw, var(--font-size-5xl)); max-width: 15ch; line-height: 1.1; padding-block-end: 0.1em; }
  .home-hero__intro { margin: 1.75rem 0 0; max-width: 42ch; font-size: var(--font-size-md); }
  .home-hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-block-start: 2.5rem; }
  .home-hero__media { position: relative; overflow: hidden; }
  .home-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) {
    .home-hero { grid-template-columns: 1fr; min-height: 0; }
    .home-hero__media { order: -1; height: 56vh; }
    .home-hero__text { padding: var(--space-xl) clamp(var(--space-md), 4vw, var(--space-xl)) var(--space-2xl); }
  }
</style>
