---
// Interior-page header in the V2 split layout: title + intro on the left over
// --solid-bg, a tall image on the right. Without an image it's a single
// left-aligned column. The fixed header sits above it (pages start below the
// header via --header-height), so nothing here ever sits under the menu bar.
// `heading` may italicize one word with *word* (see lib/utils/emphasis.ts).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { renderEmphasis } from "../lib/utils/emphasis";

export interface Props {
  heading: string;
  intro?: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string; // object-position, e.g. "50% 30%"
}
const { heading, intro, eyebrow, image, imageAlt = "", imagePosition = "50% 50%" } = Astro.props;
---

<header class:list={["page-header", !image && "page-header--text"]}>
  <div class="page-header__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-header__heading" set:html={renderEmphasis(heading)} />
    {intro && <p class="page-header__intro">{intro}</p>}
    <slot />
  </div>
  {image && (
    <div class="page-header__media">
      <Image src={image} alt={imageAlt} class="page-header__image" style={`object-position:${imagePosition}`} loading="eager" fetchpriority="high" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
  )}
</header>

<style>
  .page-header { display: grid; grid-template-columns: 1fr 1fr; min-height: 70vh; padding-block-start: var(--header-height); background: var(--solid-bg); }
  .page-header__text { display: flex; flex-direction: column; justify-content: center; padding: var(--space-2xl) clamp(var(--space-lg), 5vw, 5rem) var(--space-2xl) max(clamp(var(--space-md), 4vw, var(--space-xl)), calc((100vw - var(--container-max)) / 2 + var(--space-xl))); }
  .page-header__heading { font-size: clamp(2.5rem, 4.2vw, var(--font-size-5xl)); max-width: 15ch; line-height: 1.1; padding-block-end: 0.08em; }
  .page-header__intro { margin: var(--space-lg) 0 0; max-width: 44ch; font-size: var(--font-size-md); }
  .page-header__media { position: relative; overflow: hidden; }
  .page-header__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-header--text { grid-template-columns: 1fr; min-height: 0; }
  .page-header--text .page-header__text { padding-block: calc(var(--space-2xl) * 1.5) var(--space-2xl); }
  .page-header--text .page-header__heading { max-width: 20ch; }
  @media (max-width: 900px) {
    .page-header { grid-template-columns: 1fr; min-height: 0; }
    .page-header__media { order: -1; height: 50vh; }
    .page-header__text { padding: var(--space-xl) clamp(var(--space-md), 4vw, var(--space-xl)); }
  }
</style>
