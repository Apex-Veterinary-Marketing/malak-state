---
// Service card (V2): photo, serif title, one-line summary, arrow link. No card
// box — spacing does the grouping.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export interface Props {
  service: CollectionEntry<"services">;
}
const { service } = Astro.props;
const name = service.data.customName || service.data.name;
---

<a class="service-card" href={`/services/${service.id}`} data-hover="lift">
  {service.data.pageHeaderImage && (
    <div class="service-card__frame">
      <Image src={service.data.pageHeaderImage} alt="" class="service-card__image" widths={[480, 800]} sizes="(max-width: 767px) 100vw, 33vw" />
    </div>
  )}
  <h3 class="service-card__heading">{name}</h3>
  {service.data.featuredText && <p class="service-card__text">{service.data.featuredText}</p>}
  <span class="service-card__cta">Learn more <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .service-card { display: flex; flex-direction: column; gap: var(--space-sm); text-decoration: none; color: inherit; }
  .service-card__frame { overflow: hidden; }
  .service-card__image { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform var(--motion-duration-image) var(--motion-ease-out); }
  .service-card:hover .service-card__image { transform: scale(1.03); }
  .service-card__heading { margin: var(--space-xs) 0 0; font-size: var(--font-size-xl); }
  .service-card__text { margin: 0; color: var(--text-muted); }
  .service-card__cta { font-weight: 600; color: var(--main); }
</style>
