---
// V2 "accordion image slider": photo strips that widen on hover/focus. Every
// title starts on the same line (top-anchored), whatever the strip's width or
// text length. Stacks vertically below 900px with the text always visible.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  heading: string;
  items: { title: string; text: string; href: string; image: ImageMetadata; imageAlt?: string }[];
}
const { heading, items } = Astro.props;
---

<section class="strips-section" data-home="services">
  <div class="container">
    <h2 class="strips-section__heading" data-reveal>{heading}</h2>
    <div class="strips" data-reveal data-strips>
      {items.map((item, i) => (
        <a class:list={["strip", i === 0 && "is-active"]} href={item.href}>
          <Image src={item.image} alt={item.imageAlt || ""} class="strip__image" widths={[480, 960, 1400]} sizes="(max-width: 900px) 100vw, 60vw" />
          <div class="strip__body">
            <h3 class="strip__title">{item.title}</h3>
            <p class="strip__text">{item.text}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .strips-section { padding-block-end: clamp(5rem, 10vw, 9rem); }
  .strips-section__heading { margin-block-end: var(--space-xl); }
  .strips { display: flex; gap: var(--space-sm); height: 600px; }
  .strip { position: relative; flex: 1; min-width: 0; overflow: hidden; color: var(--white); text-decoration: none; transition: flex-grow var(--motion-duration-menu) var(--motion-ease-out); }
  .strip:hover, .strip:focus-visible, .strip.is-active { flex-grow: 3.2; }
  .strip__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .strip::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--scrim-strong) 0%, var(--scrim-mid) 45%, var(--scrim-clear) 80%); }
  .strip__body { position: absolute; z-index: 1; inset-inline: 0; inset-block-start: 62%; padding: 0 1.75rem; }
  .strip__title { margin: 0; color: var(--white); font-size: 1.55rem; line-height: 1.2; }
  .strip__text { margin: var(--space-sm) 0 0; max-width: 36ch; color: var(--on-dark-muted); opacity: 0; transform: translateY(10px); transition: opacity var(--motion-duration-reveal) var(--motion-ease-out), transform var(--motion-duration-reveal) var(--motion-ease-out); }
  .strip:hover .strip__text, .strip:focus-visible .strip__text, .strip.is-active .strip__text { opacity: 1; transform: none; transition-delay: var(--motion-duration-base); }
  @media (max-width: 900px) {
    .strips { flex-direction: column; height: auto; }
    .strip { flex: none; min-height: 340px; }
    .strip__body { inset-block: auto 0; padding: var(--space-lg); }
    .strip__text { opacity: 1; transform: none; }
  }
</style>

<script>
  document.querySelectorAll("[data-strips]").forEach((group) => {
    const strips = [...group.querySelectorAll<HTMLElement>(".strip")];
    const activate = (s: HTMLElement) => strips.forEach((o) => o.classList.toggle("is-active", o === s));
    strips.forEach((s) => {
      s.addEventListener("mouseenter", () => activate(s));
      s.addEventListener("focus", () => activate(s));
    });
  });
</script>
