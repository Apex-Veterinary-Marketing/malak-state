---
// Grounded in the real V2 export's .services-sidebar-2 (detail_services.html
// / svc-long-version-template.html) — mounted on every services-related
// page per direct instruction 2026-09-17 (the export's own sidebar only
// appears on service detail pages; generalized here to all of them for a
// consistent nav aid). Real export's sidebar is a flat list scoped to the
// current service's own category; this instead groups every category into
// its own collapsible <details> (native, zero JS — same pattern as
// Footer's accordion columns and MobileMenu's dropdowns), matching the
// "dropdowns by service category" instruction, heading "Other Services".
// Respects the services schema's showOnSidebarMenu flag (defined since the
// schema's creation, never actually consumed until this component).
// Sticky on desktop (pinned just below the fixed header) with a small "book a
// call" card under the links; a normal block below 900px.
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getServicesByCategory } from "../lib/data/services";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";

export interface Props {
  // Pre-opens this category's group and skips rendering that link (the
  // current page's own category/service shouldn't link to itself).
  activeCategoryId?: string;
  activeServiceId?: string;
}
const { activeCategoryId, activeServiceId } = Astro.props;
const site = await getSiteInfo();

const categories = await getAllServiceCategories();
const groups = (
  await Promise.all(
    categories.map(async (category) => ({
      category,
      services: (await getServicesByCategory(category.id)).filter(
        (service) => service.data.showOnSidebarMenu && service.id !== activeServiceId
      ),
    }))
  )
).filter((group) => group.services.length > 0);
---

<aside class="services-sidebar">
<nav class="services-sidebar__nav" aria-label="Other services">
  <h2 class="services-sidebar__heading">Other services</h2>
  {groups.map((group) => (
    <details class="services-sidebar__group" open={group.category.id === activeCategoryId}>
      <summary class="services-sidebar__group-title">{group.category.data.name}</summary>
      <ul class="services-sidebar__list">
        {group.services.map((service) => (
          <li><a href={`/services/${service.id}`}>{service.data.name}</a></li>
        ))}
      </ul>
    </details>
  ))}
  <a class="services-sidebar__all-link" href="/services">All services &rarr;</a>
</nav>
{site.bookingUrl && (
  <div class="services-sidebar__cta">
    <h2 class="services-sidebar__cta-title">Not sure where to start?</h2>
    <p class="services-sidebar__cta-text">Book a free 30-minute call with Marissa. No pressure, just a clear next step.</p>
    <a class="btn btn--cta services-sidebar__cta-btn" href={site.bookingUrl}>{site.bookingLabel}</a>
    {site.phoneNumber && <a class="services-sidebar__cta-phone" href={phoneHref(site)}>or call {site.phoneNumber}</a>}
  </div>
)}
</aside>

<style>
  .services-sidebar {
    flex: 0 0 18rem;
    align-self: flex-start;
    position: sticky;
    inset-block-start: calc(var(--header-height) + var(--space-lg));
    /* never taller than the space under the header; scrolls internally on short screens */
    max-block-size: calc(100vh - var(--header-height) - var(--space-lg) * 2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .services-sidebar__cta { padding: var(--space-lg); background: var(--main-dark); color: var(--on-dark-muted); }
  .services-sidebar__cta-title { margin: 0; font-size: var(--font-size-xl); color: var(--white); }
  .services-sidebar__cta-text { margin: var(--space-xs) 0 var(--space-md); font-size: var(--font-size-sm); }
  .services-sidebar__cta-btn { inline-size: 100%; justify-content: center; }
  .services-sidebar__cta-phone { display: block; margin-block-start: var(--space-sm); text-align: center; font-size: var(--font-size-sm); color: var(--white); text-decoration: none; white-space: nowrap; }
  .services-sidebar__cta-phone:hover { color: var(--cta); }
  .services-sidebar__heading { margin: 0 0 var(--space-md); font: 600 var(--font-size-xs) / 1 var(--font-body); text-transform: uppercase; letter-spacing: var(--letter-spacing-label); color: var(--text-muted); }
  .services-sidebar__group { border-block-start: 1px solid var(--light-grey); padding-block: var(--space-xs); }
  .services-sidebar__group-title { cursor: pointer; font: 400 var(--font-size-lg) / 1.3 var(--font-heading); color: var(--main-dark); padding-block: var(--space-xs); }
  .services-sidebar__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); margin-block-start: var(--space-xs); }
  .services-sidebar__list a { color: inherit; text-decoration: none; }
  .services-sidebar__list a:hover { text-decoration: underline; }
  .services-sidebar__all-link { display: inline-block; margin-block-start: var(--space-sm); font-weight: 600; color: var(--main); text-decoration: none; }
  .services-sidebar__all-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .services-sidebar { flex-basis: 100%; position: static; max-block-size: none; overflow: visible; }
  }
</style>
