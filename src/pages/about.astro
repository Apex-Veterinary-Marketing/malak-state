---
// Meet the team (nav label: "Meet Marissa"). Copy is the client's own
// onboarding answers (mission, vision, values, what's unique), used close to
// word for word. Agent profiles live at /agents/<id>.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import BrokerGrid from "../components/BrokerGrid.astro";
import BookCall from "../components/BookCall.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { getAllBrokers } from "../lib/data/brokers";
import { getAllTestimonials } from "../lib/data/testimonials";
import headerImage from "../assets/brand/marissa-seated.jpg";
import storyImage from "../assets/brand/marissa-laptop-living-room.jpg";

const brokers = await getAllBrokers();
const reviews = await getAllTestimonials();
const lead = brokers[0];
const values = ["Honesty", "Integrity", "Trust", "Exceptional service", "Client-first advocacy", "Clear communication", "Genuine relationships"];
---

<BaseLayout
  title="About The Malak Estate Group"
  description="A Cleveland real estate team rooted in clarity, preparation and thoughtful strategy. Meet REALTOR® Marissa Lubera and read what clients say."
  webPage={{ "@type": "AboutPage", ...(lead ? { mainEntity: { "@id": `/agents/${lead.id}#person` } } : {}) }}
  breadcrumb="Meet Marissa"
>
  <PageHeaderBanner
    heading="The *people* behind The Malak Estate Group"
    intro="Created by REALTOR® Marissa Lubera to provide a real estate experience rooted in clarity, preparation, and thoughtful strategy."
    image={headerImage}
    imageAlt="Marissa Lubera smiling in a velvet armchair"
    imagePosition="50% 35%"
  />

  <section class="about-intro">
    <div class="container about-intro__grid">
      <div data-reveal>
        <h2>Real estate, made clear and achievable.</h2>
        <p class="lede">Real estate doesn't have to feel confusing or intimidating. What makes The Malak Estate Group unique is our personalized, relationship-first approach. We combine honest guidance, clear communication, strong market knowledge, and thoughtful strategy to help every client move with confidence.</p>
        <p>Rather than offering a one-size-fits-all experience, we take the time to understand each client's goals and tailor our approach to their specific situation, whether they're buying, selling, relocating, investing, or exploring new construction. Our clients choose us because they feel informed, supported, and genuinely cared for from the first conversation through closing and beyond.</p>
      </div>
      <Image src={storyImage} alt="Marissa Lubera working from a sunlit living room" class="about-intro__image" data-reveal widths={[480, 800]} sizes="(max-width: 767px) 100vw, 40vw" />
    </div>
  </section>

  <section class="about-pillars">
    <div class="container about-pillars__grid">
      <div data-reveal>
        <h2 class="about-pillars__title">What we stand for</h2>
        <p>Our mission is to provide an elevated real estate experience rooted in honesty, integrity, and exceptional service. Whether buying or selling, every client receives personalized guidance, clear communication, and an advocate who consistently puts their best interests first.</p>
      </div>
      <div data-reveal>
        <h2 class="about-pillars__title">Where we're headed</h2>
        <p>Our vision is to establish The Malak Estate Group as one of the most trusted and respected real estate names in Northeast Ohio, recognized for a luxury level of service at every price point. As our team grows, clients will know that anyone representing our name is committed to delivering the same high standard of care, knowledge, and professionalism.</p>
      </div>
      <div data-reveal>
        <h2 class="about-pillars__title">How we work</h2>
        <ul class="about-pillars__values">{values.map((v) => <li>{v}</li>)}</ul>
      </div>
    </div>
  </section>

  {brokers.length === 1 && lead.data.mainImage ? (
    <section class="about-team">
      <div class="container about-bio">
        <Image src={lead.data.mainImage} alt={lead.data.imageAltText || lead.data.name} class="about-bio__image" data-reveal widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 40vw" />
        <div class="about-bio__text" data-reveal>
          <h2>Meet {lead.data.name}.</h2>
          <p class="about-bio__title">{lead.data.title}</p>
          <p class="lede">I created The Malak Estate Group to provide a real estate experience rooted in clarity, preparation, and thoughtful strategy.</p>
          <p>Before stepping into general real estate, I worked full-time for a national builder, where I was responsible for managing listings, guiding buyers through complex timelines, and ensuring each home was positioned and marketed thoughtfully. That experience shaped the way I approach real estate today. I learned how pricing, presentation, financing, and communication all work together to influence outcomes.</p>
          <p>What I value most is helping clients understand what’s truly possible. Many buyers and sellers assume certain options are out of reach simply because they haven’t been shown otherwise. I take the time to break down numbers, explain scenarios, and walk through choices so clients feel empowered rather than overwhelmed.</p>
          <p class="about-bio__closing">Real estate doesn’t have to feel confusing or intimidating. With the right guidance, it can feel clear and achievable.</p>
          <ArrowLink href={`/agents/${lead.id}`} text={`More about ${lead.data.shortName || lead.data.name}`} />
        </div>
      </div>
    </section>
  ) : brokers.length > 0 && (
    <section class="about-team">
      <div class="container">
        <h2 data-reveal>Our agents.</h2>
        <div class="about-team__grid"><BrokerGrid brokers={brokers} /></div>
      </div>
    </section>
  )}

  {lead && lead.data.awards.length > 0 && (
    <section class="about-awards">
      <div class="container">
        <h2 data-reveal>Recognition.</h2>
        <dl class="about-awards__grid" data-reveal>
          {lead.data.awards.map((a) => (
            <div><dt>{a.years}</dt><dd>{a.name}{a.detail && `, ${a.detail.charAt(0).toLowerCase()}${a.detail.slice(1)}`}</dd></div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="about-reviews" id="reviews">
      <div class="container">
        <h2 data-reveal>Kind words from my clients.</h2>
        <p class="lede" data-reveal>Real stories. Real experiences. Real results.</p>
        <div class="about-reviews__grid" data-reveal-stagger>
          {reviews.map((r) => (
            <figure class="about-review" data-reveal>
              <blockquote>&ldquo;{r.data.testimonial}&rdquo;</blockquote>
              <figcaption>{r.data.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <BookCall />
</BaseLayout>

<style>
  .about-intro { padding-block: clamp(5rem, 10vw, 8rem); }
  .about-intro__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .about-intro__grid p:not(.lede) { max-width: 60ch; margin-block-start: var(--space-lg); }
  .about-intro__image { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about-pillars { padding-block: clamp(4rem, 8vw, 6rem); background: var(--solid-bg); }
  .about-pillars__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2xl) clamp(2rem, 4vw, 4rem); }
  .about-pillars__title { font-size: var(--font-size-2xl); margin-block-end: var(--space-md); }
  .about-pillars__grid p { margin: 0; }
  .about-pillars__values { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .about-pillars__values li { padding: var(--space-xs) var(--space-md); background: var(--white); font-size: var(--font-size-sm); }
  .about-team { padding-block: clamp(5rem, 10vw, 8rem); }
  .about-team__grid { margin-block-start: var(--space-xl); }
  .about-bio { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .about-bio__image { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; position: sticky; inset-block-start: calc(var(--header-height) + var(--space-lg)); }
  .about-bio__title { margin: var(--space-xs) 0 0; font-size: var(--font-size-xs); font-weight: 600; letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--text-muted); }
  .about-bio__text p:not(.lede):not(.about-bio__title) { max-width: 60ch; margin-block: var(--space-lg) 0; }
  .about-bio__text .about-bio__closing { font: italic 400 var(--font-size-xl)/1.45 var(--font-heading); color: var(--main-dark); margin-block-end: var(--space-xl); }
  @media (max-width: 900px) { .about-bio { grid-template-columns: 1fr; } .about-bio__image { position: static; } }
  .about-awards { padding-block: 0 clamp(5rem, 10vw, 8rem); }
  .about-awards__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-xl); margin: var(--space-xl) 0 0; }
  .about-awards__grid > div { padding-block-start: var(--space-lg); border-block-start: 1px solid var(--cta); }
  .about-awards__grid dt { font: 400 2.2rem/1 var(--font-heading); color: var(--main-dark); }
  .about-awards__grid dd { margin: var(--space-sm) 0 0; font-size: var(--font-size-sm); }
  .about-reviews { padding-block: clamp(5rem, 10vw, 8rem); background: var(--solid-bg); }
  .about-reviews__grid { columns: 2 22rem; column-gap: var(--space-xl); margin-block-start: var(--space-xl); }
  .about-review { break-inside: avoid; margin: 0 0 var(--space-xl); padding: var(--space-xl); background: var(--white); }
  .about-review blockquote { margin: 0; font: italic 400 var(--font-size-lg)/1.5 var(--font-heading); color: var(--main-dark); }
  .about-review figcaption { margin-block-start: var(--space-md); font-size: var(--font-size-xs); font-weight: 600; letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--text-muted); }
  @media (max-width: 900px) { .about-pillars__grid { grid-template-columns: 1fr; } .about-awards__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) { .about-intro__grid, .about-awards__grid { grid-template-columns: 1fr; } }
</style>
