---
// Gather & Ground (client's direct request): what it is, upcoming events,
// photos from past events. Event nodes are emitted only for upcoming events.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import EventList from "../components/EventList.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import BookCall from "../components/BookCall.astro";
import { getEventsSplit } from "../lib/data/events";
import { getGallery } from "../lib/data/gallery";
import { Image } from "astro:assets";
import headerImage from "../assets/gather-and-ground/lawn-group.jpg";
import ggLogo from "../assets/gather-and-ground/gather-and-ground-logo.png";

const { upcoming, past } = await getEventsSplit();
const photos = await getGallery("gather-and-ground");
// Gather & Ground has its own Instagram, separate from the brokerage account.
const GG_INSTAGRAM = "https://www.instagram.com/gatherandgroundcle/";
const STATUS_URL = { scheduled: "EventScheduled", cancelled: "EventCancelled", postponed: "EventPostponed" } as const;

const graph: Record<string, any>[] = upcoming.map((e) => ({
  "@type": "Event",
  "@id": `#event-${e.id}`,
  name: e.data.name,
  startDate: e.data.startDate.toISOString(),
  endDate: e.data.endDate?.toISOString(),
  eventStatus: `https://schema.org/${STATUS_URL[e.data.status]}`,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: e.data.venueName || "Greater Cleveland", address: e.data.venueAddress || "Northeast Ohio" },
  organizer: { "@id": "#business" },
  image: e.data.image ? new URL(e.data.image.src, Astro.site).href : undefined,
}));
if (photos.length) {
  graph.push({
    "@type": "ImageGallery",
    "@id": "#gallery",
    name: "Gather & Ground past gatherings",
    associatedMedia: photos.map((p) => ({ "@type": "ImageObject", contentUrl: new URL(p.data.image.src, Astro.site).href, caption: p.data.caption || p.data.alt })),
  });
}
---

<BaseLayout
  title="Gather & Ground Community Events"
  description="Gather & Ground is a monthly, movement-based community experience in Cleveland centered around health, wellness and connection. See upcoming events."
  schemaGraph={graph}
  webPage={{ "@type": "CollectionPage" }}
  breadcrumb="Gather & Ground"
>
  <PageHeaderBanner
    heading="Gather & *Ground*"
    intro="A monthly community experience built around movement and connection."
    image={headerImage}
    imageAlt="Gather and Ground group photo on a city lawn"
  />

  <section class="gg-about">
    <div class="container gg-about__grid" data-reveal>
      <div>
        <Image src={ggLogo} alt="Gather and Ground: movement, wellness, connection" class="gg-about__logo" widths={[320, 640]} sizes="20rem" />
        <h2>What is Gather &amp; Ground?</h2>
      </div>
      <div>
        <p class="lede">In a world that keeps us constantly connected online, genuine human connection can feel harder to find in real life.</p>
        <p>Through conversations with friends and people in our own circle, one theme kept coming up. It's surprisingly difficult to meet new people and build real friendships in day-to-day life. Not from a dating perspective. Simply from a human one.</p>
        <p>Between busy schedules, working from home, and spending more time on our phones than ever before, organic opportunities to connect don't happen the way they used to.</p>
        <p>Gather &amp; Ground was created to make that easier. Gather &amp; Ground is a monthly, movement-based community experience centered around health, wellness, and connection.</p>
        <p>Each month, we gather locally to move our bodies, spend time outside when possible, and create space for conversation and presence. The format may change, including Pilates, pickleball, bike rides, or other wellness-focused gatherings, but the intention remains the same.</p>
        <p class="gg-about__closing">To slow down. To connect. To ground ourselves in something real.</p>
        <p>Just movement, community, and something to look forward to.</p>
      </div>
    </div>
  </section>

  <section class="gg-events">
    <div class="container">
      <h2 data-reveal>Upcoming gatherings.</h2>
      <div class="gg-events__list">
        <EventList events={upcoming} emptyText="Stay connected and follow along for upcoming events on Instagram, @GatherandGroundCLE." />
        <p class="gg-events__follow"><a href={GG_INSTAGRAM} target="_blank" rel="noopener noreferrer">Follow @GatherandGroundCLE</a></p>
      </div>
    </div>
  </section>

  {(past.length > 0 || photos.length > 0) && (
    <section class="gg-past">
      <div class="container">
        <h2 data-reveal>Past gatherings.</h2>
        {past.length > 0 && <div class="gg-past__list"><EventList events={past.slice(0, 6)} /></div>}
        {photos.length > 0 && <div class="gg-past__photos"><GalleryGrid items={photos} id="gg-lightbox" layout="cards" /></div>}
      </div>
    </section>
  )}

  <BookCall />
</BaseLayout>

<style>
  .gg-about { padding-block: clamp(5rem, 10vw, 8rem); }
  .gg-about__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 6vw, 5rem); }
  .gg-about__grid p:not(.lede) { max-width: 60ch; margin-block-start: var(--space-lg); }
  .gg-about__logo { width: min(100%, 20rem); height: auto; margin-block-end: var(--space-lg); }
  .gg-about__closing { font: italic 400 var(--font-size-xl)/1.4 var(--font-heading); color: var(--main-dark); }
  .gg-about__grid .lede { margin-block-start: 0; }
  .gg-events { padding-block: clamp(4rem, 8vw, 6rem); background: var(--solid-bg); }
  .gg-events__list { margin-block-start: var(--space-xl); max-width: 52rem; }
  .gg-events__follow { margin: var(--space-md) 0 0; }
  .gg-events__follow a { color: var(--main); font-weight: 600; }
  .gg-past { padding-block: clamp(5rem, 10vw, 8rem); }
  .gg-past__list, .gg-past__photos { margin-block-start: var(--space-xl); }
  @media (max-width: 900px) { .gg-about__grid { grid-template-columns: 1fr; } }
</style>
