---
// Homepage, built to the approved V2 preview
// (docs/design/homepage-variations/v2-fullscreen-menu.html), section for
// section: split hero → mission → service strips → Meet Marissa → builders →
// featured homes → testimonial (only with real reviews) → Gather & Ground →
// book a call. `npm run check:seo` asserts the section order.
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import MissionQuote from "../components/MissionQuote.astro";
import ServiceStrips from "../components/ServiceStrips.astro";
import MeetBroker from "../components/MeetBroker.astro";
import BuildersFeature from "../components/BuildersFeature.astro";
import ListingGrid from "../components/ListingGrid.astro";
import ArrowLink from "../components/ArrowLink.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import GatherTeaser from "../components/GatherTeaser.astro";
import BookCall from "../components/BookCall.astro";
import { getSiteInfo } from "../lib/data/site";
import { getHomeBrokers } from "../lib/data/brokers";
import { getFeaturedListings } from "../lib/data/listings";
import { getAllTestimonials } from "../lib/data/testimonials";
import heroImage from "../assets/brand/marissa-doorway-wide.jpg";
import buyingImage from "../assets/placeholders/interior-living.jpg";
import sellingImage from "../assets/placeholders/house-brick.jpg";
import newBuildImage from "../assets/placeholders/house-new-build.jpg";
import relocationImage from "../assets/placeholders/house-colonial.jpg";
import buildersImage from "../assets/placeholders/house-white-modern.jpg";

const site = await getSiteInfo();
const [broker] = await getHomeBrokers();
const listings = await getFeaturedListings(3);
const testimonials = await getAllTestimonials();

const strips = [
  { title: "Buying", text: "A clear plan for buying with confidence, shaped around your budget, timeline, and the neighborhoods that fit your life.", href: "/services/buying-a-home", image: buyingImage },
  { title: "Selling", text: "Selling with strategy, not guesswork: pricing, presentation, and preparation tailored to your home.", href: "/services/selling-your-home", image: sellingImage },
  { title: "New construction", text: "Years inside a national builder's sales office, now on your side of the table from lot selection to final walkthrough.", href: "/services/new-construction", image: newBuildImage },
  { title: "Relocation & downsizing", text: "Moving to Northeast Ohio or into your next chapter, with every detail handled.", href: "/services/relocation", image: relocationImage },
];

const graph = [
  {
    "@type": "ItemList",
    "@id": "#services",
    name: "Real estate services",
    itemListElement: strips.map((s, i) => ({ "@type": "ListItem", position: i + 1, name: s.title, url: new URL(s.href, Astro.site).href })),
  },
];
const about = [{ "@id": "#business" }, ...(broker ? [{ "@id": `/agents/${broker.id}#person` }] : [])];
---

<BaseLayout
  title="Cleveland Realtor | The Malak Estate Group"
  titleTemplate="full"
  description="Buying or selling a home is a major decision. Marissa Lubera, REALTOR®, guides you with clarity, honesty, and a plan that aligns with your goals."
  schemaGraph={graph}
  webPage={{ about }}
  breadcrumb={false}
>
  <HomeHero
    heading="Cleveland real estate, guided with *intention.*"
    intro="Buying or selling a home is a major decision. My role is to guide you through it with clarity, honesty, and a plan that aligns with your goals."
    image={heroImage}
    imageAlt="Marissa Lubera opening the double front doors of a home"
    primary={{ text: site.bookingLabel || "Book a call", href: site.bookingUrl || "/schedule" }}
    secondary={{ text: "View listings", href: "/listings" }}
  />

  <MissionQuote quote="Honest guidance, clear communication, and an advocate who puts *your* interests first." label="Our mission" />

  <ServiceStrips heading="Every kind of move, one steady guide." items={strips} />

  {broker && (
    <MeetBroker
      broker={broker}
      intro="With six years across resale and new construction, Marissa brings a well-rounded perspective to every move. What sets her apart is how invested she is in the people she serves: you'll feel informed, supported, and genuinely cared for."
    />
  )}

  <BuildersFeature
    heading="For builders and developers."
    text="Greater Cleveland is building. Marissa spent years making sure each new home was positioned and marketed thoughtfully for a national builder, and she brings that same care to your community."
    image={buildersImage}
    imageAlt="Newly completed white contemporary home"
    cta={{ text: "Partner with Marissa", href: "/builders-developers" }}
  />

  {listings.length > 0 && (
    <section class="home-listings">
      <div class="container">
        <div class="home-listings__head" data-reveal>
          <h2>Featured homes.</h2>
          <ArrowLink href="/listings" text="All listings" />
        </div>
        <ListingGrid listings={listings} layout="feature" />
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="home-quote">
      <div class="container" data-reveal>
        <TestimonialSlider
          testimonials={testimonials.map((t) => ({ name: t.data.name, testimonial: t.data.testimonial, image: t.data.image, imageAltText: t.data.imageAltText }))}
        />
      </div>
    </section>
  )}

  <GatherTeaser />

  <BookCall home />
</BaseLayout>

<style>
  .home-listings { padding-block: clamp(5rem, 10vw, 9rem); }
  .home-listings__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-lg); margin-block-end: var(--space-xl); }
  .home-quote { padding-block-end: clamp(5rem, 10vw, 9rem); }
</style>
