---
// Meet the team — interim version (rebuilt in plan Task 7).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import { getAllBrokers } from "../lib/data/brokers";

const brokers = await getAllBrokers();
---

<BaseLayout title="Meet the Team" description="Meet the agents of The Malak Estate Group.">
  <PageHeaderBanner heading="Meet the Team" />
  <ul>{brokers.map((b) => <li><a href={`/agents/${b.id}`}>{b.data.name}</a></li>)}</ul>
</BaseLayout>
