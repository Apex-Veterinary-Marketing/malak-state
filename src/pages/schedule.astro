---
// Booking page: every "Book a call" CTA points here (site.bookingUrl). The
// Calendly scheduler (site.calendlyUrl) is embedded inline; a ScheduleAction
// on the WebPage points at it.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import CalendlyEmbed from "../components/CalendlyEmbed.astro";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";

const site = await getSiteInfo();
---

<BaseLayout
  title="Book a Call with Marissa Lubera"
  description="Pick a time for a free 30-minute call about buying, selling, relocating, or building in Northeast Ohio. No pressure, just a clear next step."
  webPage={site.calendlyUrl ? { potentialAction: { "@type": "ScheduleAction", target: site.calendlyUrl } } : undefined}
  breadcrumb="Book a call"
>
  <PageHeaderBanner heading="Book a *30-minute* call" intro="Pick a time that suits you. No pressure, just a clear next step." />

  <section class="schedule">
    <div class="container schedule__grid">
      <div class="schedule__embed"><CalendlyEmbed height="47.5rem" /></div>
      <aside class="schedule__aside">
        <h2 class="schedule__title">What we'll cover</h2>
        <ul class="schedule__list">
          <li>Your goals and your timeline</li>
          <li>What the market looks like for you right now</li>
          <li>The next right step, with no obligation</li>
        </ul>
        <h2 class="schedule__title">Prefer to talk now?</h2>
        {site.phoneNumber && <a class="schedule__phone" href={phoneHref(site)}>{site.phoneNumber}</a>}
        <p class="schedule__hours">Monday to Sunday, 8am to 8pm.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule { padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 10vw, 8rem); }
  .schedule__grid { display: grid; grid-template-columns: 2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .schedule__embed { border: 1px solid var(--light-grey); }
  .schedule__aside { padding: var(--space-xl); background: var(--solid-bg); }
  .schedule__title { font-size: var(--font-size-xl); margin: 0 0 var(--space-md); }
  .schedule__title + .schedule__phone { display: inline-block; }
  .schedule__list { margin: 0 0 var(--space-xl); padding-inline-start: 1.1em; display: grid; gap: var(--space-xs); }
  .schedule__phone { font: 400 var(--font-size-2xl)/1.1 var(--font-heading); color: var(--main-dark); text-decoration: none; white-space: nowrap; }
  .schedule__hours { margin: var(--space-xs) 0 0; font-size: var(--font-size-sm); color: var(--text-muted); }
  @media (max-width: 900px) { .schedule__grid { grid-template-columns: 1fr; } }
</style>
