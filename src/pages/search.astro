---
// Minimal placeholder: a real search index is future work (out of scope per
// Skeleton-Build-Spec.md §13). The route exists because the WebSite schema's
// SearchAction points at it. Noindexed so it never appears in results.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
---

<BaseLayout title="Search" description="Search The Malak Estate Group website." noindex>
  <PageHeaderBanner heading="Search" intro="Looking for something specific? Try one of these, or book a call and ask Marissa directly.">
    <ul class="search-links">
      <li><a href="/listings">Listings</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/builders-developers">Builders &amp; Developers</a></li>
      <li><a href="/faq">FAQ</a></li>
      <li><a href="/contact-us">Contact</a></li>
    </ul>
  </PageHeaderBanner>
</BaseLayout>

<style>
  .search-links { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-md) var(--space-lg); margin: var(--space-xl) 0 0; padding: 0; }
  .search-links a { color: var(--main); font-weight: 600; }
</style>
