---
// Service category listing (Buying / Selling / Specialties).
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeaderBanner from "../../components/PageHeaderBanner.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import BookCall from "../../components/BookCall.astro";
import { getAllServiceCategories } from "../../lib/data/serviceCategories";
import { getServicesByCategory } from "../../lib/data/services";

export async function getStaticPaths() {
  const categories = await getAllServiceCategories();
  return categories.map((category) => ({ params: { slug: category.id }, props: { category } }));
}

const { category } = Astro.props;
const services = await getServicesByCategory(category.id);
const headerImage = services.find((s) => s.data.pageHeaderImage)?.data.pageHeaderImage;
const graph = [
  {
    "@type": "ItemList",
    "@id": "#services",
    itemListElement: services.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.data.customName || s.data.name,
      url: new URL(`/services/${s.id}`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title={`${category.data.name} Services`}
  description={category.data.description}
  schemaGraph={graph}
  webPage={{ "@type": "CollectionPage", mainEntity: { "@id": "#services" } }}
  breadcrumb={category.data.name}
>
  <PageHeaderBanner heading={`${category.data.name} *services*`} intro={category.data.intro} image={headerImage} />
  <section class="category">
    <div class="container">
      {services.length > 0 ? <ServiceGrid services={services} /> : <p class="category__empty">Services in this category are coming soon.</p>}
    </div>
  </section>
  <BookCall />
</BaseLayout>

<style>
  .category { padding-block: clamp(5rem, 10vw, 8rem); }
  .category__empty { color: var(--text-muted); }
</style>
