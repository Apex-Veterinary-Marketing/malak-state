---
// Service detail (agency standard): 3 text+image blocks alternating sides, a
// closing "cta" block with the booking button, 5 researched FAQs (sources are
// linked inside the answers). Schema: Service (+ audience), FAQPage when there
// are FAQs, manualSchema appended (escape hatch, never replacing).
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeaderBanner from "../../components/PageHeaderBanner.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import ServicesSidebar from "../../components/ServicesSidebar.astro";
import BookCall from "../../components/BookCall.astro";
import { getAllServices } from "../../lib/data/services";
import { getServiceCategoryBySlug } from "../../lib/data/serviceCategories";
import { getSiteInfo } from "../../lib/data/site";
import { unlinkScheduledArticles } from "../../lib/data/blog";
import { stripHtml } from "../../lib/utils/stripHtml";
import { withTrackingPhone } from "../../lib/utils/phone";
import { areaServedNode } from "../../lib/schema/areaServed";

export async function getStaticPaths() {
  const services = await getAllServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const site = await getSiteInfo();
const heading = service.data.customName || service.data.name;

// Rich text: tel: links dial the tracking number, and links to scheduled
// (unpublished) blog posts render as plain text until the post is live.
const clean = async (html: string) => withTrackingPhone(await unlinkScheduledArticles(html), site);
const blocks = await Promise.all(service.data.contentBlocks.map(async (b) => ({ ...b, body: await clean(b.body) })));
const faqs = await Promise.all(service.data.faqs.map(async (f) => ({ ...f, answer: await clean(f.answer) })));

const categories = (await Promise.all(service.data.serviceCategory.map((ref) => getServiceCategoryBySlug(ref.id)))).filter(Boolean);
const areas = (site.serviceAreaOfCoverage || "").split(",").map((s) => s.trim()).filter(Boolean);

const graph: Record<string, any>[] = [
  {
    "@type": "Service",
    "@id": "#service",
    name: heading,
    serviceType: service.data.name,
    description: service.data.metaDescription || service.data.featuredText || undefined,
    category: categories.map((c) => c!.data.name),
    url: new URL(`/services/${service.id}`, Astro.site).href,
    image: service.data.pageHeaderImage ? new URL(service.data.pageHeaderImage.src, Astro.site).href : undefined,
    provider: { "@id": "#business" },
    areaServed: areas.length ? areas.map(areaServedNode) : undefined,
    audience: service.data.audience ? { "@type": "Audience", audienceType: service.data.audience } : undefined,
  },
];

if (faqs.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": "#faq",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: stripHtml(faq.answer) },
    })),
  });
}

if (service.data.manualSchema) {
  try {
    const parsed = JSON.parse(service.data.manualSchema);
    graph.push(...(Array.isArray(parsed) ? parsed : [parsed]));
  } catch {
    // Malformed manualSchema shouldn't break the build (escape hatch, append-only).
  }
}
const contentBlocks = blocks.filter((b) => b.style !== "cta");
const ctaBlock = blocks.find((b) => b.style === "cta");
---

<BaseLayout
  title={service.data.metaTitle || heading}
  description={service.data.metaDescription}
  ogImage={service.data.pageHeaderImage}
  ogImageAlt={`${heading}, ${site.practiceName}`}
  schemaGraph={graph}
  webPage={{ mainEntity: { "@id": "#service" } }}
  breadcrumb={heading}
>
  <PageHeaderBanner heading={heading} intro={service.data.featuredText} image={service.data.pageHeaderImage}>
    <div class="service-hero__cta"><a class="btn btn--cta" href={site.bookingUrl}>{site.bookingLabel}</a></div>
  </PageHeaderBanner>

  <section class="service">
    <div class="container service__layout">
      <div class="service__main">
        {contentBlocks.map((block, i) => (
          <div class:list={["service-block", i % 2 === 1 && "service-block--reverse"]} data-reveal>
            {block.image && <Image src={block.image} alt="" class="service-block__image" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 35vw" />}
            <div class="service-block__body service-rt" set:html={block.body} />
          </div>
        ))}

        {ctaBlock && (
          <div class="service-cta" data-reveal>
            <div class="service-rt" set:html={ctaBlock.body} />
            <a class="btn btn--cta" href={site.bookingUrl}>{site.bookingLabel}</a>
          </div>
        )}

        {faqs.length > 0 && (
          <div class="service__faqs" data-reveal>
            <FaqAccordion faqs={faqs} heading="Frequently asked questions" />
          </div>
        )}
      </div>
      <ServicesSidebar activeCategoryId={categories[0]?.id} activeServiceId={service.id} />
    </div>
  </section>

  <BookCall />
</BaseLayout>

<style>
  .service-hero__cta { margin-block-start: var(--space-xl); }
  .service { padding-block: clamp(5rem, 10vw, 8rem); }
  /* Content + sticky sidebar side by side above 900px (grid, so the sidebar never wraps under the content); stacked below. */
  .service__layout { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .service__main { min-width: 0; display: flex; flex-direction: column; gap: clamp(3rem, 7vw, 6rem); }
  @media (max-width: 900px) { .service__layout { grid-template-columns: 1fr; } }
  .service-block { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .service-block--reverse .service-block__image { order: 2; }
  .service-block__image { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .service-rt :global(h2) { font-size: clamp(1.8rem, 2.8vw, 2.4rem); margin: 0 0 var(--space-md); }
  .service-rt :global(p) { margin: 0 0 var(--space-md); }
  .service-rt :global(p:last-child) { margin-block-end: 0; }
  .service-cta { padding: clamp(2rem, 4vw, 3rem); background: var(--solid-bg); }
  .service-cta .btn { margin-block-start: var(--space-lg); }
  @media (max-width: 900px) {
    .service-block { grid-template-columns: 1fr; }
    .service-block--reverse .service-block__image { order: 0; }
    .service-block__image { aspect-ratio: 4 / 3; }
  }
</style>
