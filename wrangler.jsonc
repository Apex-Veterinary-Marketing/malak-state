// Cloudflare Workers (static assets) deploy config.
// - "name" MUST equal the Worker's name in the Cloudflare dashboard. Rename it
//   per client (e.g. "acmevet"); a mismatch makes Cloudflare deploy a separate
//   Worker, and the connected one keeps serving its "Hello World" stub.
// - Workers Builds (Git-connected): build command `npm run build`, deploy
//   command `npx wrangler deploy`. Every push to main rebuilds and deploys.
// - Preview: keep the build variable SITE_URL set to the workers.dev address
//   (see astro.config.mjs), so the preview stays noindexed.
//
// MALAK (2026-10-02): this Worker is the STAGING PREVIEW for now. Production is
// GitHub Pages (.github/workflows/deploy-pages.yml, docs/launch/github-pages-launch.md),
// because the client keeps the domain at Wix and Wix won't move the nameservers.
// The Cloudflare production setup is kept below as a FALLBACK
// (docs/launch/cloudflare-rules.md) in case DNS can move to Cloudflare.
{
  // The Worker in the Cloudflare dashboard (connected to this repo's main, 2026-10-02).
  "name": "malak-state",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // FALLBACK: Cloudflare as production. The apex is canonical (site.ts url); www
  // 301s to it through a Cloudflare Redirect Rule (docs/launch/cloudflare-rules.md).
  // Both hosts attach as custom domains on the first `wrangler deploy`, which
  // needs the themalakestategroup.com zone active in this Cloudflare account
  // (the nameservers have to move to Cloudflare first). Path redirects from the
  // old Wix URLs ship as dist/_redirects (generated in astro.config.mjs).
  //
  // To switch: set the repo variable PAGES_LIVE to false so GitHub Pages stops
  // publishing, uncomment "routes" (and add a comma after the "assets" block),
  // remove the SITE_URL build variable, run `npm run check:launch`, then push.
  // check:launch treats active routes as "Cloudflare is production".
  //
  // "routes": [
  //   { "pattern": "themalakestategroup.com", "custom_domain": true },
  //   { "pattern": "www.themalakestategroup.com", "custom_domain": true }
  // ]
}
