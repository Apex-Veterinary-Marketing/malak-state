// Cloudflare Workers (static assets) deploy config.
// - "name" MUST equal the Worker's name in the Cloudflare dashboard. Rename it
//   per client (e.g. "acmevet"); a mismatch makes Cloudflare deploy a separate
//   Worker, and the connected one keeps serving its "Hello World" stub.
// - Workers Builds (Git-connected): build command `npm run build`, deploy
//   command `npx wrangler deploy`. Every push to main rebuilds and deploys.
// - Pre-launch preview: set the build variable SITE_URL to the workers.dev
//   address (see astro.config.mjs); remove it at launch.
{
  // TODO(client): set to the Cloudflare Worker name for themalakestategroup.com (check:launch blocks until then)
  "name": "skeleton",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Final domain: the apex themalakestategroup.com is canonical (site.ts url);
  // www 301s to it through a Cloudflare Redirect Rule (docs/launch/cloudflare-rules.md).
  // Both hosts attach as custom domains on the first `wrangler deploy`, which
  // needs the themalakestategroup.com zone active in this Cloudflare account
  // (registrar is Wix, so the nameservers move to Cloudflare first).
  // DON'T deploy with these routes until launch day: attaching the custom
  // domains moves the live site off Wix. Path redirects from the old Wix URLs
  // ship as dist/_redirects (generated in astro.config.mjs).
  "routes": [
    { "pattern": "themalakestategroup.com", "custom_domain": true },
    { "pattern": "www.themalakestategroup.com", "custom_domain": true }
  ]
}
